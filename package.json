{
  "name": "remotion-video-editor",
  "version": "1.0.0",
  "description": "Desktop Remotion Video Editor with Electron & React",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -s first \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build:remotion": "node scripts/prepare-remotion.js",
    "build:electron": "electron-builder",
    "build": "npm run build:vite && npm run build:remotion && npm run build:electron",
    "typecheck": "tsc --noEmit -p ."
  },
  "keywords": [
    "remotion",
    "video-editor",
    "electron",
    "react"
  ],
  "author": "",
  "build": {
    "appId": "com.remotion.videoeditor",
    "productName": "Remotion Video Editor Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "remotion-bundle",
        "to": "remotion-bundle"
      },
      {
        "from": "node_modules/.remotion/chrome-headless-shell",
        "to": "chrome-headless-shell"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "license": "ISC",
  "dependencies": {
    "@remotion/bundler": "^4.0.527",
    "@remotion/player": "^4.0.527",
    "@remotion/renderer": "^4.0.527",
    "@remotion/transitions": "^4.0.527",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.527"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
